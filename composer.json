{
    "name": "spyck/accounting-sonata-bundle",
    "description": "Accounting Sonata Bundle for Symfony",
    "license": "MIT",
    "authors": [
        {
            "name": "Willem Verspyck",
            "email": "willemverspyck@outlook.com",
            "homepage": "https://verspyck.com",
            "role": "Developer"
        }
    ],
    "keywords": [
        "php",
        "sonata",
        "accounting"
    ],
    "homepage": "https://github.com/willemverspyck/accounting-sonata-bundle",
    "type": "library",
    "require": {
        "php": "^8.4",
        "sonata-project/admin-bundle": "^4",
        "sonata-project/doctrine-orm-admin-bundle": "^4",
        "sonata-project/form-extensions": "^2",
        "spyck/accounting-bundle": "dev-main",
        "spyck/sonata-extension": "dev-main",
        "symfony/framework-bundle": "^7.4|^8"
    },
    "require-dev": {
        "escapestudios/symfony2-coding-standard": "^3",
        "friendsofphp/php-cs-fixer": "^3",
        "phpunit/phpunit": "^13",
        "squizlabs/php_codesniffer": "^4"
    },
    "autoload": {
        "psr-4": {
            "Spyck\\AccountingSonataBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Spyck\\AccountingSonataBundle\\Tests\\": "tests/"
        }
    }
}
